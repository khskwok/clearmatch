<mxfile host="app.diagrams.net">
  <diagram name="ClearMatch Azure Architecture" id="clearmatch-arch">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Web Front End -->
        <mxCell id="2" value="Web front end&#xa;to request and view reconciliation results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="260" height="120" as="geometry"/>
        </mxCell>
        <!-- Azure Static Web App -->
        <mxCell id="3" value="Azure Static Web App" style="shape=mxgraph.azure2.web_apps;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#1976d2;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="180" height="60" as="geometry"/>
        </mxCell>
        <!-- Azure Functions -->
        <mxCell id="4" value="Azure Functions&#xa;/api/reconcile&#xa;/api/explain" style="shape=mxgraph.azure2.functions;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#43a047;" vertex="1" parent="1">
          <mxGeometry x="500" y="140" width="180" height="60" as="geometry"/>
        </mxCell>
        <!-- Azure OpenAI -->
        <mxCell id="5" value="Azure OpenAI&#xa;DeepSeek-V3.2" style="shape=mxgraph.azure2.machine_learning_services;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#8e24aa;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="180" height="60" as="geometry"/>
        </mxCell>
        <!-- GitHub -->
        <mxCell id="6" value="GitHub&#xa;Source Repository" style="shape=mxgraph.github.octocat;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="800" y="300" width="120" height="60" as="geometry"/>
        </mxCell>
        <!-- CI/CD Arrow -->
        <mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1976d2;" edge="1" parent="1" source="6" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- User Arrow -->
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1976d2;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Web App to Functions -->
        <mxCell id="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#43a047;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Functions to OpenAI -->
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8e24aa;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Functions to Web App (results) -->
        <mxCell id="11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#43a047;" edge="1" parent="1" source="4" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Web App to Web Front End (results) -->
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#1976d2;" edge="1" parent="1" source="3" target="2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>